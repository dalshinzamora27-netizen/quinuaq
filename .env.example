# Copia este archivo como .env y completa los valores

# Clave secreta para firmar sesiones. Genera una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto

# Base de datos. Si no se define, se usa SQLite (archivo quinuaq.db).
# SQL Server con autenticacion de Windows:
# DATABASE_URL=mssql+pyodbc://MI-PC\SQLEXPRESS/quinuaq_db?driver=ODBC+Driver+17+for+SQL+Server&trusted_connection=yes
DATABASE_URL=sqlite:///quinuaq.db

# Origenes extra permitidos para Socket.IO, separados por coma (vacio = solo el mismo sitio)
SOCKETIO_CORS_ORIGINS=
